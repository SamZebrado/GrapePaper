{
  "name": "grapepaper",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-notices.mjs",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/prepare-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "server": "node server/index.mjs",
    "test:server": "node --test server/companion.test.mjs",
    "test:zotero": "node --test zotero/bridge.test.mjs",
    "build:zotero": "node zotero/build.mjs",
    "test:all": "npm run test:run && npm run test:server && npm run test:zotero",
    "lint:reading": "eslint src/reader src/GrapeApplication.tsx",
    "test:e2e": "node scripts/e2e-reading.mjs"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "framer-motion": "^11.15.0",
    "i18next": "^26.0.5",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
